
#include <iostream>
using namespace std;

// Class to represent a complex number
class Complex {
    float real, imag;

public:
    // Constructor to initialize real and imaginary parts
    Complex(float r = 0, float i = 0) {
        real = r;
        imag = i;
    }

    // Overloading the /= operator for complex division
    Complex& operator/=(const Complex& c) {
        // Calculate the denominator: real^2 + imaginary^2
        float denominator = c.real * c.real + c.imag * c.imag;

        // Check if the divisor is zero
        if (denominator == 0) {
            cout << "Error: Division by zero!" << endl;
            return *this;
        }

        // Store the original values before updating
        float r = real;
        float i = imag;

        // Calculate the real part of the result
        real = (r * c.real + i * c.imag) / denominator;

        // Calculate the imaginary part of the result
        imag = (i * c.real - r * c.imag) / denominator;

        // Return the current object
        return *this;
    }

    // Function to display the complex number
    void display() {
        cout << real;
        if (imag >= 0)
            cout << " + " << imag << "i" << endl;
        else
            cout << " - " << -imag << "i" << endl;
    }
};

int main() {
    float r1, i1, r2, i2;

    // Input the first complex number
    cout << "Enter real and imaginary parts of first number: ";
    cin >> r1 >> i1;

    // Input the second complex number
    cout << "Enter real and imaginary parts of second number: ";
    cin >> r2 >> i2;

    // Create complex number objects
    Complex c1(r1, i1);
    Complex c2(r2, i2);

    // Display the original complex numbers
    cout << "First complex number: ";
    c1.display();

    cout << "Second complex number: ";
    c2.display();

    // Divide c1 by c2 using the overloaded /= operator
    c1 /= c2;

    // Display the result
    cout << "Result after division: ";
    c1.display();

    return 0;
}
